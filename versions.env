# Pinned versions for this build. Change a version here, run
#   ./scripts/fetch-sources.sh --update-lock
# review the new hashes in sources.lock, commit both files, then tag
#   ffmpeg-<FFMPEG_VERSION>-<BUILD_REVISION>
# to publish a release.

FFMPEG_VERSION=9.0.2
DAV1D_VERSION=1.5.4
LAME_VERSION=3.100
# zlib is only built for Windows; macOS and Linux use the system copy.
ZLIB_VERSION=1.3.1

# Bump this when you rebuild the same FFmpeg version (new flags, new deps).
BUILD_REVISION=1

# Oldest macOS the binaries must run on.
MACOS_MIN_VERSION=11.0

# FFmpeg release signing key (see https://ffmpeg.org/download.html).
FFMPEG_GPG_FINGERPRINT=FCF986EA15E6E293A5644F10B4322F04D67658D8

# Space-separated FFmpeg encoders to leave out, e.g. "aac" if you only want
# the OS-provided AAC encoders (aac_at on macOS, aac_mf on Windows).
DISABLE_ENCODERS=""
